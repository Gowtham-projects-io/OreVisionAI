# OreVision AI — Environment Variables
# =====================================================================
# IMPORTANT: This file is for LOCAL development only.
# For cloud hosting, set these values in your platform's Secrets/Environment
# Variables interface — NEVER commit actual credentials to Git.
# =====================================================================

# ── Copernicus / Sentinel Hub Credentials ──────────────────────────
# Obtain from: https://dataspace.copernicus.eu/ → Dashboard → OAuth Clients
SH_CLIENT_ID=your-client-id-here
SH_CLIENT_SECRET=your-client-secret-here

# ── Application Settings ───────────────────────────────────────────
DEBUG=false

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
